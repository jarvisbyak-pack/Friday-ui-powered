# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# FRIDAY server configuration. All are server-only; do not prefix private values with VITE_.
PORT="3000"
FRIDAY_DATA_DIR="data"
FRIDAY_DEFAULT_PROVIDER="gemini"
GEMINI_MODEL="gemini-2.5-flash"

# n8n API and execution configuration. An API key is used only by the server.
# N8N_WORKFLOW_WEBHOOKS_JSON maps a n8n workflow id or exact workflow name to its approved webhook URL.
N8N_BASE_URL="https://n8n.example.com"
N8N_API_KEY=""
N8N_WORKFLOW_WEBHOOKS_JSON='{"attendance-workflow":"https://n8n.example.com/webhook/attendance"}'
# Keep false by default. Create/update/activate/deactivate operations remain unavailable otherwise.
FRIDAY_ALLOW_N8N_MUTATIONS="false"

# Reserved for future server-side adapters. No adapter is enabled merely by setting these.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
